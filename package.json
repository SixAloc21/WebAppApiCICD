{
  "name": "webappapinode",
  "version": "1.0.0",
  "description": "API REST con Node.js, Express, SQLite, pruebas automatizadas y CI/CD",
  "main": "src/app.js",
  "scripts": {
  "start": "node src/app.js",
  "dev": "nodemon src/app.js",
  "test": "jest --runInBand",
  "test:coverage": "jest --runInBand --coverage",
  "format": "prettier --write ."
},
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "keywords": [
    "nodejs",
    "express",
    "sqlite",
    "jest",
    "docker",
    "cicd"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}